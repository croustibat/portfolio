---
import type { Locale } from "../i18n";
import { pick } from "../i18n";
import { journey } from "../data/journey";
import { mapData } from "../data/mapData";

const { locale } = Astro.props as { locale: Locale };

const copy = {
  fr: {
    eyebrow: "00",
    title: "Parcours",
    subtitle: "De Dijon à Nantes, 20 ans à travers l'Europe.",
    scrollHint: "Scroll pour voyager",
    prev: "Précédente",
    next: "Prochaine étape",
  },
  en: {
    eyebrow: "00",
    title: "Journey",
    subtitle: "From Dijon to Nantes, 20 years across Europe.",
    scrollHint: "Scroll to travel",
    prev: "Previous",
    next: "Next stop",
  },
};
const t = copy[locale];

const typeLabels: Record<string, Record<string, string>> = {
  fr: { job: "Poste", project: "Projet", milestone: "Milestone", education: "Formation" },
  en: { job: "Role", project: "Project", milestone: "Milestone", education: "Education" },
};

// Build the ordered route points (projected map coordinates) + curved segments.
const points = journey.map((stop) => ({ id: stop.id, city: stop.city, ...mapData.cities[stop.id] }));

// "Flight" arcs between consecutive cities: quadratic Bézier bowing to one side.
const segments = points.slice(1).map((p, i) => {
  const a = points[i];
  const dx = p.x - a.x;
  const dy = p.y - a.y;
  const len = Math.hypot(dx, dy) || 1;
  const k = 0.18; // curvature amount
  const cx = (a.x + p.x) / 2 + (dy / len) * len * k;
  const cy = (a.y + p.y) / 2 - (dx / len) * len * k;
  return { d: `M${a.x},${a.y} Q${cx.toFixed(1)},${cy.toFixed(1)} ${p.x},${p.y}` };
});
---

<section id="journey" class="journey relative py-16" aria-labelledby="journey-title" data-mode="list">
  <div class="absolute left-0 right-0 top-0 flex items-center gap-4">
    <div class="h-px flex-1 bg-gradient-to-r from-transparent via-[rgb(var(--border))] to-transparent"></div>
  </div>

  <div class="animate-on-scroll mb-8">
    <span class="text-xs font-medium uppercase tracking-widest text-[rgb(var(--accent-tertiary))]">{t.eyebrow}</span>
    <h2 id="journey-title" class="mt-2 text-3xl font-bold tracking-tight text-[rgb(var(--text-primary))] md:text-4xl">{t.title}</h2>
    <p class="mt-3 max-w-md text-[rgb(var(--text-secondary))]">{t.subtitle}</p>
  </div>

  {/* ============ INTERACTIVE MAP (desktop + JS) ============ */}
  <div class="journey-map">
    <div class="journey-pin relative">
      <div class="grid w-full items-center gap-8 md:grid-cols-2">
        {/* Map */}
        <div class="relative">
          <div class="journey-scrollhint pointer-events-none absolute left-4 top-4 z-10 flex items-center gap-2 text-[10px] font-medium uppercase tracking-widest text-[rgb(var(--text-tertiary))]">
            <span>{t.scrollHint}</span>
            <span class="arrow-bounce">↓</span>
          </div>
          <div class="relative aspect-square w-full overflow-hidden rounded-3xl border border-[rgb(var(--border))] bg-[rgb(var(--bg-primary))]">
            <svg class="h-full w-full" viewBox={mapData.viewBox} preserveAspectRatio="xMidYMid slice" role="img" aria-label={t.title}>
              <g class="journey-camera">
                <path d={mapData.land} class="journey-land" />
                <path d={mapData.borders} class="journey-borders" fill="none" />
                {segments.map((s, i) => (
                  <path d={s.d} class="journey-segment" data-seg={i} fill="none" />
                ))}
                {points.map((p, i) => (
                  <circle cx={p.x} cy={p.y} r="4" class="journey-dot" data-dot={i} />
                ))}
                {points.map((p, i) => (
                  <text x={p.x} y={p.y - 11} class="journey-label" data-label={i} text-anchor="middle">{p.city}</text>
                ))}
                <g class="journey-marker" data-marker>
                  <circle r="7" class="journey-marker-halo" />
                  <circle r="3.5" class="journey-marker-core" />
                </g>
              </g>
            </svg>
          </div>
        </div>

        {/* Right column: panels + step navigation */}
        <div>
          <div class="journey-panels relative min-h-[320px]">
          {journey.map((stop, i) => (
            <article class="journey-panel absolute inset-0" data-panel={i} aria-hidden={i === 0 ? "false" : "true"}>
              <div class="flex items-baseline gap-3">
                <div>
                  <h3 class="text-2xl font-bold tracking-tight text-[rgb(var(--text-primary))]">{stop.city}</h3>
                  <p class="text-sm text-[rgb(var(--text-tertiary))]">{pick(stop.country, locale)} · {stop.period}</p>
                </div>
                <span class="ml-auto font-mono text-xs text-[rgb(var(--text-tertiary))]">{String(i + 1).padStart(2, "0")}/{String(journey.length).padStart(2, "0")}</span>
              </div>
              <div class="mt-5 space-y-3">
                {stop.roles.map((role) => (
                  <div class="rounded-xl border border-[rgb(var(--border)/0.6)] bg-[rgb(var(--bg-secondary))] p-4">
                    <div class="mb-1.5 flex items-center gap-2">
                      <span class={`inline-block rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider ${
                        role.type === "job"
                          ? "bg-[rgb(var(--accent)/0.1)] text-[rgb(var(--accent))]"
                          : role.type === "project"
                          ? "bg-[rgb(var(--accent-secondary)/0.1)] text-[rgb(var(--accent-secondary))]"
                          : role.type === "milestone"
                          ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                          : "bg-[rgb(var(--accent-tertiary)/0.1)] text-[rgb(var(--accent-tertiary))]"
                      }`}>{typeLabels[locale][role.type]}</span>
                      <span class="text-xs font-medium text-[rgb(var(--text-secondary))]">{role.org}</span>
                      <span class="ml-auto font-mono text-[11px] text-[rgb(var(--text-tertiary))]">{role.period}</span>
                    </div>
                    <h4 class="text-sm font-semibold text-[rgb(var(--text-primary))]">{pick(role.title, locale)}</h4>
                    <p class="mt-1 text-[13px] leading-relaxed text-[rgb(var(--text-secondary))]">{pick(role.description, locale)}</p>
                  </div>
                ))}
              </div>
            </article>
          ))}
          </div>

          <div class="journey-nav mt-6 flex items-center gap-3">
            <button
              type="button"
              class="journey-prev inline-flex items-center gap-2 rounded-full border border-[rgb(var(--border))] px-4 py-2.5 text-sm font-medium text-[rgb(var(--text-secondary))] transition hover:border-[rgb(var(--text-tertiary))] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--accent))] disabled:cursor-not-allowed disabled:opacity-30"
            >
              <span aria-hidden="true">←</span> {t.prev}
            </button>
            <button
              type="button"
              class="journey-next inline-flex items-center gap-2 rounded-full bg-[rgb(var(--text-primary))] px-5 py-2.5 text-sm font-medium text-[rgb(var(--bg-primary))] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[rgb(var(--accent))] disabled:cursor-not-allowed disabled:opacity-30"
            >
              {t.next} <span aria-hidden="true">→</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* ============ FALLBACK LIST (mobile / no-JS / reduced-motion) ============ */}
  <ol class="journey-fallback mt-4 space-y-6 border-l border-[rgb(var(--border))] pl-6">
    {journey.map((stop) => (
      <li class="relative">
        <span class="absolute -left-[27px] top-1.5 h-3 w-3 rounded-full border-2 border-[rgb(var(--accent))] bg-[rgb(var(--bg-primary))]"></span>
        <div class="flex items-baseline gap-2">
          <h3 class="text-lg font-bold text-[rgb(var(--text-primary))]">{stop.city}</h3>
          <span class="text-xs text-[rgb(var(--text-tertiary))]">· {stop.period}</span>
        </div>
        <div class="mt-2 space-y-2">
          {stop.roles.map((role) => (
            <div class="rounded-lg border border-[rgb(var(--border)/0.6)] bg-[rgb(var(--bg-secondary))] p-3">
              <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-[rgb(var(--text-secondary))]">{role.org}</span>
                <span class="ml-auto font-mono text-[11px] text-[rgb(var(--text-tertiary))]">{role.period}</span>
              </div>
              <h4 class="mt-0.5 text-sm font-semibold text-[rgb(var(--text-primary))]">{pick(role.title, locale)}</h4>
              <p class="mt-1 text-[13px] leading-relaxed text-[rgb(var(--text-secondary))]">{pick(role.description, locale)}</p>
            </div>
          ))}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  /* Default: fallback list shown, interactive map hidden (no-JS safe). */
  .journey-map { display: none; }
  .journey[data-mode="map"] .journey-map { display: block; }
  .journey[data-mode="map"] .journey-fallback { display: none; }

  .journey-land {
    fill: rgb(var(--bg-tertiary));
    stroke: rgb(var(--text-tertiary) / 0.45);
    stroke-width: 0.75;
  }
  .journey-borders {
    stroke: rgb(var(--text-tertiary) / 0.35);
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
  }
  .journey-segment {
    stroke: rgb(var(--accent));
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .journey-land { vector-effect: non-scaling-stroke; }
  .journey-dot {
    fill: rgb(var(--bg-primary));
    stroke: rgb(var(--accent) / 0.5);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .journey-marker-halo { fill: rgb(var(--accent) / 0.25); }
  .journey-marker-core { fill: rgb(var(--accent)); }

  .journey-label {
    fill: rgb(var(--text-tertiary));
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    opacity: 0.8;
    pointer-events: none;
    paint-order: stroke;
    stroke: rgb(var(--bg-primary));
    stroke-width: 3px;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .journey-label.is-active {
    fill: rgb(var(--accent));
    opacity: 1;
  }
  .journey-dot.is-active {
    fill: rgb(var(--accent));
    stroke: rgb(var(--accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .journey-map { display: none !important; }
    .journey-fallback { display: block !important; }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { MotionPathPlugin } from "gsap/MotionPathPlugin";

  gsap.registerPlugin(ScrollTrigger, MotionPathPlugin);

  const Z = 1.9; // camera zoom factor (lower = more of France visible)
  let triggers: ScrollTrigger[] = [];

  const initJourney = () => {
    // Clean up any previous instance (View Transitions re-runs scripts).
    triggers.forEach((tr) => tr.kill());
    triggers = [];

    const section = document.querySelector<HTMLElement>(".journey");
    if (!section) return;

    const desktop = window.matchMedia("(min-width: 768px)").matches;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!desktop || reduce) {
      section.dataset.mode = "list";
      return;
    }
    section.dataset.mode = "map";

    const svg = section.querySelector<SVGSVGElement>("svg");
    const marker = section.querySelector<SVGGElement>(".journey-marker");
    const pin = section.querySelector<HTMLElement>(".journey-pin");
    const segs = gsap.utils.toArray<SVGPathElement>(".journey-segment");
    const dots = gsap.utils.toArray<SVGCircleElement>(".journey-dot");
    const labels = gsap.utils.toArray<SVGTextElement>(".journey-label");
    const panels = gsap.utils.toArray<HTMLElement>(".journey-panel");
    const prevBtn = section.querySelector<HTMLButtonElement>(".journey-prev");
    const nextBtn = section.querySelector<HTMLButtonElement>(".journey-next");
    if (!svg || !marker || !pin || !dots.length) return;

    const vb = svg.getAttribute("viewBox")!.split(" ").map(Number);
    const full = { w: vb[2], h: vb[3] };
    const P = dots.map((d) => ({ x: +d.getAttribute("cx")!, y: +d.getAttribute("cy")! }));
    const total = P.length - 1;

    // Camera = animated viewBox window (robust pan, constant zoom).
    const viewFor = (p: { x: number; y: number }) => ({
      x: p.x - full.w / Z / 2,
      y: p.y - full.h / Z / 2,
      w: full.w / Z,
      h: full.h / Z,
    });
    const cam = viewFor(P[0]);
    const applyCam = () => svg.setAttribute("viewBox", `${cam.x} ${cam.y} ${cam.w} ${cam.h}`);
    applyCam();

    // Hide each arc until it is drawn (getTotalLength handles curves too).
    segs.forEach((seg) => {
      const L = seg.getTotalLength();
      gsap.set(seg, { strokeDasharray: L, strokeDashoffset: L });
    });

    gsap.set(marker, { x: P[0].x, y: P[0].y });
    gsap.set(panels, { autoAlpha: 0 });
    gsap.set(panels[0], { autoAlpha: 1 });

    // Active city highlight (label + dot + nav disabled state).
    let activeIdx = -1;
    const setActive = (idx: number) => {
      if (idx === activeIdx) return;
      activeIdx = idx;
      dots.forEach((d, j) => d.classList.toggle("is-active", j === idx));
      labels.forEach((l, j) => l.classList.toggle("is-active", j === idx));
      if (prevBtn) prevBtn.disabled = idx <= 0;
      if (nextBtn) nextBtn.disabled = idx >= total;
    };
    const updateActive = (progress: number) => {
      const time = progress * total;
      let idx = 0;
      for (let i = 1; i < P.length; i++) if (time >= i - 1 + 0.55) idx = i;
      setActive(idx);
    };

    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: pin,
        start: "center center",
        end: () => "+=" + P.length * window.innerHeight * 0.7,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true,
        onUpdate: (self) => updateActive(self.progress),
      },
    });

    for (let i = 1; i < P.length; i++) {
      const at = i - 1;
      tl.to(segs[i - 1], { strokeDashoffset: 0 }, at);
      tl.to(marker, { motionPath: { path: segs[i - 1], alignOrigin: [0.5, 0.5] } }, at);
      tl.to(cam, { ...viewFor(P[i]), onUpdate: applyCam }, at);
      tl.to(panels[i - 1], { autoAlpha: 0, duration: 0.3, ease: "power1.out" }, at + 0.3);
      tl.to(panels[i], { autoAlpha: 1, duration: 0.3, ease: "power1.in" }, at + 0.55);
    }

    setActive(0);

    // Step navigation: jump to a city's scroll position; scrub:1 animates the trip.
    // The <html> uses scroll-behavior:smooth (Tailwind's scroll-smooth), which
    // swallows programmatic scrollTo — force 'auto' just for the jump.
    const st = tl.scrollTrigger!;
    const jumpTo = (idx: number) => {
      const clamped = Math.max(0, Math.min(total, idx));
      const y = Math.min(st.start + (clamped / total) * (st.end - st.start), st.end - 2);
      const html = document.documentElement;
      const prev = html.style.scrollBehavior;
      html.style.scrollBehavior = "auto";
      window.scrollTo(0, y);
      html.style.scrollBehavior = prev;
    };
    if (prevBtn) prevBtn.onclick = () => jumpTo(activeIdx - 1);
    if (nextBtn) nextBtn.onclick = () => jumpTo(activeIdx + 1);

    triggers = ScrollTrigger.getAll();
  };

  initJourney();
  document.addEventListener("astro:page-load", initJourney);
  document.addEventListener("astro:before-swap", () => {
    triggers.forEach((tr) => tr.kill());
    triggers = [];
  });
</script>
